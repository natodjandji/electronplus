{
  "hosting": {
    "public": "frontend/dist/client",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/_shell.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "// comment": "frontend/public/assets/brand/** is copied verbatim into dist/client/assets/ alongside Vite's content-hashed build chunks, so it matches the immutable rule above too — but these filenames never change on edit (no content hash), so a 1-year immutable cache meant a brand-color/logo update here silently never reached anyone. Overrides back to no-cache for this one subpath; hashed build assets elsewhere under /assets/ are unaffected.",
        "source": "/assets/brand/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "auth": {
    "providers": {
      "anonymous": false,
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Electron Plus",
        "supportEmail": "electronplusve@gmail.com"
      }
    }
  }
}
