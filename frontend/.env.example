# Copy to `.env.local` for local dev, or set these in your hosting
# platform / CI for a production build (see `.env.production` for what's
# actually deployed). Never commit `.env.local` — already in .gitignore.

# Backend API base URL.
VITE_API_BASE_URL=http://localhost:3000/api

# Firebase web app config — these are public identifiers, not secrets
# (Firebase access is controlled by Firestore/Storage security rules, not
# by keeping this config hidden). Get them from Firebase Console > Project
# settings > General > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# PayPal client id — also meant to be public (embedded in the JS SDK
# script tag every buyer's browser loads). Use a sandbox client id here for
# local dev; production uses a live one in .env.production.
VITE_PAYPAL_CLIENT_ID=

# Canonical public origin for absolute URLs (canonical links, og:url,
# JSON-LD, sitemap) — see src/lib/site-url.ts. Falls back to the *.web.app
# Firebase Hosting URL if unset.
VITE_PUBLIC_SITE_URL=
