{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:dev"],
      "port": 3000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 8080
    },
    {
      "name": "hosting",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "firebase",
        "serve",
        "--only",
        "hosting",
        "--port",
        "5055",
        "--project",
        "electronplus-ve"
      ],
      "port": 5055
    }
  ]
}
