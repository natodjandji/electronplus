# Copia este archivo a ".env" y completa los valores reales.
# El archivo ".env" real NUNCA debe subirse a git (ya está en .gitignore).

# --- Conexión a SQL Server (Profit Plus, tienda secundaria) ---
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=NOMBRE_BASE_PROFIT_SECUNDARIA
DB_USER=usuario_sql
DB_PASSWORD=contraseña_sql
# true solo si tu SQL Server exige TLS con certificado válido
DB_ENCRYPT=false

# Código de almacén a filtrar (opcional). Si lo dejas vacío, la API suma el
# stock de TODOS los almacenes por artículo.
WAREHOUSE_CODE=

# --- API ---
# Puerto distinto al del bridge de la tienda principal (4000) por si algún
# día ambos corren en la misma máquina.
PORT=4001
# Token estático que debe mandar cualquier cliente en el header:
# Authorization: Bearer <API_KEY>
# Genera uno largo y aleatorio, por ejemplo con: openssl rand -hex 32
# Usa una clave DISTINTA a la del bridge principal.
API_KEY=cambia-esto-por-un-token-largo-y-aleatorio
