# Copia este archivo a ".env" y completa los valores reales.
# El archivo ".env" real NUNCA debe subirse a git (ya está en .gitignore).

# --- Conexión a SQL Server (Profit Plus, tienda secundaria) ---
# "EQUIPO\INSTANCIA" (requiere el servicio SQL Server Browser) o solo "EQUIPO"
# con el puerto fijo de la instancia en DB_PORT.
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=NOMBRE_BASE_PROFIT_SECUNDARIA
# Un usuario de solo lectura (rol db_datareader), nunca "sa".
DB_USER=usuario_sql
DB_PASSWORD=contraseña_sql
# true solo si tu SQL Server exige TLS.
DB_ENCRYPT=false
# false para además validar el certificado del servidor (necesita uno válido).
DB_TRUST_SERVER_CERT=true

# --- API ---
# Puerto distinto al del bridge de la tienda principal (4000) por si algún
# día ambos corren en la misma máquina.
PORT=4001
# Solo esta PC: el túnel de Cloudflare entra por 127.0.0.1. Si cloudflared
# corre en OTRA PC de la red, pon aquí 0.0.0.0 (ver "Actualizar" en el README).
HOST=127.0.0.1
# Clave que debe mandar el backend en el header: Authorization: Bearer <API_KEY>
# Mínimo 32 caracteres y DISTINTA a la del bridge principal; el bridge no
# arranca con este valor de ejemplo. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=cambia-esto-por-un-token-largo-y-aleatorio
