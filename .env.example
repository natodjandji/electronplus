# Copy this file to `.env` and fill in real values. Never commit `.env`
# itself — it's already covered by .gitignore (.env, .env.*).
# See src/config/env.validation.ts for the authoritative schema (types,
# defaults, which vars are required vs optional).

NODE_ENV=development
PORT=3000
API_PREFIX=api

# Required. Firebase project id.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Base64-encoded service-account JSON. Optional locally if you use
# `gcloud auth application-default login` or GOOGLE_APPLICATION_CREDENTIALS
# instead — required in most hosted environments (e.g. Cloud Run) unless
# running on GCP infra with an attached service account.
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Optional — defaults to the project's default Storage bucket name.
FIREBASE_STORAGE_BUCKET=

# Public storefront URL — what product QR codes point to.
PUBLIC_SITE_URL=https://electronplus.com.ve

# Principal store's Profit Plus integration, through
# profit-plus-bridge-principal. The sync skips until both are set.
PROFIT_PLUS_SYNC_CRON=*/15 * * * *
PROFIT_PLUS_API_URL=
PROFIT_PLUS_API_KEY=

# Second (secundaria) store's entirely separate Profit Plus integration —
# different physical SQL Server, different bridge, different Firestore
# collection. See src/modules/second-store/second-store-sync.service.ts.
SECOND_STORE_PROFIT_API_URL=
SECOND_STORE_PROFIT_API_KEY=
SECOND_STORE_SYNC_CRON=*/30 * * * *

# Cashea (compra ahora, paga en cuotas). Cashea's integration team issues
# both keys, the external client id and the store id; the method is offered
# once all four are set (and an admin turns it on in Métodos de pago). The
# public key creates checkouts; the private one confirms down payments and
# cancels orders — server-side only (Secret Manager in production).
CASHEA_PUBLIC_KEY=
CASHEA_PRIVATE_KEY=
CASHEA_EXTERNAL_CLIENT_ID=
CASHEA_STORE_ID=
CASHEA_STORE_NAME=Electron Plus
CASHEA_MERCHANT_NAME=Electron Plus

# Mercasist (src/modules/mercasist): Mercado Libre Venezuela through
# mercasist.com. Optional — the admin panel (/admin/mercasist) shows the
# setup steps until it's set. The token is the Mercasist account's own (user
# menu → Token de API); in production it comes from Secret Manager
# (mercasist-api-token).
MERCASIST_API_TOKEN=

LOW_STOCK_DEFAULT_THRESHOLD=10

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Comma-separated list of allowed origins, or '*'. Production should list
# real origins explicitly (see the comment above app.enableCors in
# src/main.ts for why '*' is unsafe there despite being the schema default).
CORS_ORIGIN=*

# Transactional email. Optional — EmailService logs instead of sending when
# unset.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_REPLY_TO=electronplusve@gmail.com
