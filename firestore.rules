rules_version = '2';

// No client reads or writes Firestore directly. The web app only uses
// Firebase Auth; every read and write goes through the NestJS API, which
// uses the Admin SDK (rules don't apply to it) and enforces ownership,
// roles, pricing and stock itself.
//
// Earlier rules let a signed-in client create and update its own quotes
// directly — so it could write `status: 'approved'` with any unit price,
// which the API then trusted when converting the quote into an order.
// Anything opened here bypasses every check the API makes, so keep it
// closed: add an API endpoint instead.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
