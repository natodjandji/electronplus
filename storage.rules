rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Product photos — the catalog links them as public `?alt=media` URLs,
    // so each file is readable by anyone who has its path. Listing the
    // bucket is not: nothing needs it, and it would expose every upload.
    // Only the backend (Admin SDK, which bypasses these rules) writes here.
    match /products/{allPaths=**} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // Payment-proof screenshots — sensitive, so no direct client access at
    // all. The backend reads/writes via the Admin SDK and hands out a
    // short-lived signed URL to whoever is authorized to see a given proof.
    match /payment-proofs/{allPaths=**} {
      allow read, write: if false;
    }
  }
}
