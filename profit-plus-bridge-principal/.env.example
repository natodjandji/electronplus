# Copia este archivo a ".env" y completa los valores reales.
# El archivo ".env" real NUNCA debe subirse a git (ya está en .gitignore).

# --- Conexión a SQL Server (Profit Plus) ---
# "EQUIPO\INSTANCIA" (requiere el servicio SQL Server Browser) o solo "EQUIPO"
# con el puerto fijo de la instancia en DB_PORT.
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=NOMBRE_BASE_PROFIT
# Un usuario de solo lectura (rol db_datareader), nunca "sa".
DB_USER=usuario_sql
DB_PASSWORD=contraseña_sql
# true solo si tu SQL Server exige TLS.
DB_ENCRYPT=false
# false para además validar el certificado del servidor (necesita uno válido).
DB_TRUST_SERVER_CERT=true

# Código de almacén a filtrar (opcional). Si lo dejas vacío, la API suma el
# stock de TODOS los almacenes por artículo.
WAREHOUSE_CODE=

# --- API ---
PORT=4000
# Solo esta PC. El túnel de Cloudflare entra por 127.0.0.1; cambiarlo expone
# el bridge a toda la red de la tienda.
HOST=127.0.0.1
# Clave que debe mandar el backend en el header: Authorization: Bearer <API_KEY>
# Mínimo 32 caracteres; el bridge no arranca con este valor de ejemplo.
# Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=cambia-esto-por-un-token-largo-y-aleatorio
